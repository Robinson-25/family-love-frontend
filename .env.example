# Dirección del backend Express
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Dirección del panel de administración
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# NextAuth (sesión del sitio público)
NEXTAUTH_URL=http://localhost:3000
# Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Google (mismo Client ID que el backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
